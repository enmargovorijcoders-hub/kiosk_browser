      xhr.open("GET", DB_STAGE_URL + "?_t=" + (new Date().getTime()), true);
      xhr.onreadystatechange = function () {
        if (xhr.readyState === 4 && xhr.status >= 200 && xhr.status < 300) {
          var raw = xhr.responseText ? xhr.responseText.replace(/^"+|"+$/g, "").replace(/\s+/g, "") : "green";
          var label = document.getElementById("current-label");
          if (label) {
            label.innerHTML = (raw || "green").toUpperCase();
          }
        }
      };
      xhr.send();
    }

    refreshLabel();
    setInterval(refreshLabel, 1000);
  </script>

  </div>

  <footer>Status Display (<span id="conn-status">syncing...</span>) | AI-generated code</footer>

  <script>
    (function () {
      var DB_STAGE_URL = "https://room-status-info-default-rtdb.europe-west1.firebasedatabase.app/door/stage.json";
      var lastStage = "";

      function setActiveStage(stage) {
        var squares = document.getElementsByClassName("square");
        for (var i = 0; i < squares.length; i++) {
          squares[i].className = squares[i].className.replace(/\s* active /g, "");
        }
        var target = document.getElementById("sq-" + stage);
        if (target) {
          target.className = target.className + " active";
        }
      }

      function pollStage() {
        try {
          var xhr = new XMLHttpRequest();
          var cacheBustUrl = DB_STAGE_URL + "?_t=" + (new Date().getTime());
          xhr.open("GET", cacheBustUrl, true);
          xhr.onreadystatechange = function () {
            if (xhr.readyState === 4) {
              var statusEl = document.getElementById("conn-status");
              if (xhr.status >= 200 && xhr.status < 300) {
                if (statusEl) {
                  statusEl.innerHTML = "live";
                }
                var raw = xhr.responseText ? xhr.responseText.replace(/^"+|"+$/g, "").replace(/\s+/g, "") : "";
                var nextStage = (raw === "green" || raw === "orange" || raw === "red") ? raw : "green";
                if (nextStage !== lastStage) {
                  lastStage = nextStage;
                  setActiveStage(nextStage);
                }
              } else {
                if (statusEl) {
                  statusEl.innerHTML = "err " + xhr.status;
                }
              }
            }
          };
          xhr.send();
        } catch (e) {
          var statusEl = document.getElementById("conn-status");
          if (statusEl) {
            statusEl.innerHTML = "err";
          }
        }
      }

      pollStage();
      setInterval(pollStage, 400);
    })();
  </script>
</body>
</html>
